# 复制为 .env 后按需修改。.env 不要提交到版本库。
#
# 关于 DEEPSEEK_BASE_URL 的取值（实测坑）：
#   容器里的 DNS 是 Docker 自己的解析器（127.0.0.11），它**不继承宿主机
#   的 DNS 后缀搜索列表**。因此宿主上能用的裸主机名 `fq-dgx-01` 在容器里
#   解析失败（No address associated with hostname），必须写全限定名
#   `fq-dgx-01.local`。两者都实测过：容器里 fq-dgx-01 失败、fq-dgx-01.local 成功。
#   若 .local 也不通，直接写 IP（DHCP 会变，变了要改这里）。
DEEPSEEK_API_KEY=fq-dgx
DEEPSEEK_BASE_URL=http://fq-dgx-01.local:8888/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash

POSTGRES_USER=mistakebook
POSTGRES_PASSWORD=mistakebook_dev_pw
POSTGRES_DB=mistakebook

API_PORT=8000
DAILY_REVIEW_MINUTES=20